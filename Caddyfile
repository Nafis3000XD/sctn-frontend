{$SCTN_SITE_ADDRESS::80} {
	encode zstd gzip

	@backend path /api /api/* /uploads /uploads/* /healthz
	handle @backend {
		reverse_proxy {$SCTN_API_UPSTREAM:backend:3000}
	}

	handle /assets/* {
		root * {$SCTN_STATIC_ROOT:/srv}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * {$SCTN_STATIC_ROOT:/srv}
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
